# Copy to .env (or export in your shell) before starting the backend.

# Anthropic API key used by the AI analysis modules.
ANTHROPIC_API_KEY=sk-ant-...

# Claude model used for all analysis. Defaults to claude-opus-4-8.
AI_MODEL=claude-opus-4-8

# Secret used to sign JWT access tokens. Change this in production.
SECRET_KEY=change-me-to-a-long-random-string

# Default admin account created on first startup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Firebase — service account file path.
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# Named Firestore database (optional — defaults to (default) if empty).
FIREBASE_DATABASE_ID=hr-ai-agent

# Firebase Web API key — found in Firebase Console → Project Settings → Web API Key.
# Required for Firebase Auth email/password sign-in via the login endpoint.
FIREBASE_WEB_API_KEY=
