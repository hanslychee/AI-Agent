# Copy to .env (or export in your shell) before starting the backend.

# Anthropic API key used by the AI analysis modules.
ANTHROPIC_API_KEY=sk-ant-...

# Claude model used for all analysis. Defaults to claude-opus-4-8.
AI_MODEL=claude-opus-4-8

# Secret used to sign JWT access tokens. Change this in production.
SECRET_KEY=change-me-to-a-long-random-string

# Default admin account created on first startup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# SQLite database location.
DATABASE_URL=sqlite:///./recruitai.db
